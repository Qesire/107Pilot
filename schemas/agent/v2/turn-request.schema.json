{
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "turn_id",
    "owner",
    "state_version",
    "task_kind",
    "model_profile_id",
    "prompt_profile_id",
    "toolset_id",
    "input",
    "capability_token",
    "checkpoint",
    "limits",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pilot107.agent-turn-request/v2"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "task_kind": {
      "anyOf": [
        {"type": "string", "const": "interactive_readonly"},
        {"type": "string", "const": "experiment_builder"}
      ]
    },
    "model_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "prompt_profile_id": {
      "anyOf": [
        {"type": "string", "const": "hpc-readonly-v1"},
        {"type": "string", "const": "platform_coach"},
        {"type": "string", "const": "experiment_builder"}
      ]
    },
    "toolset_id": {
      "anyOf": [
        {"type": "string", "const": "a1-readonly"},
        {"type": "string", "const": "a2-project"}
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "message",
        "context_refs"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64000
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "capability_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "turn_id",
            "lineage",
            "model_profile_id",
            "prompt_profile_id",
            "messages",
            "completed_tools",
            "usage",
            "digest"
          ],
          "properties": {
            "schema_version": {
              "type": "string",
              "const": "pilot107.agent-checkpoint/v1"
            },
            "turn_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "lineage": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              "maxItems": 256
            },
            "model_profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "prompt_profile_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            "messages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "role",
                  "content",
                  "tool_call_id",
                  "tool_name",
                  "is_error"
                ],
                "properties": {
                  "role": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "user"
                      },
                      {
                        "type": "string",
                        "const": "assistant"
                      },
                      {
                        "type": "string",
                        "const": "tool_result"
                      }
                    ]
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 256000
                  },
                  "tool_call_id": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      }
                    ]
                  },
                  "tool_name": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9._:-]+$"
                      }
                    ]
                  },
                  "is_error": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 4096
            },
            "completed_tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "tool_call_id",
                  "tool_name",
                  "arguments",
                  "result",
                  "is_error"
                ],
                "properties": {
                  "tool_call_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  "tool_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  },
                  "arguments": {
                    "type": "object",
                    "maxProperties": 4096,
                    "propertyNames": {
                      "not": {
                        "pattern": "^(?:[aA][pP][iI]_[kK][eE][yY]|[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[bB][aA][sS][eE]_[uU][rR][lL]|[sS][yY][sS][tT][eE][mM]_[pP][rR][oO][mM][pP][tT]|[sS][cC][hH][eE][mM][aA]|[tT][oO][oO][lL][sS])$"
                      }
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/jsonValue"
                    }
                  },
                  "result": {
                    "$ref": "#/$defs/jsonValue"
                  },
                  "is_error": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "maxItems": 4096
            },
            "usage": {
              "type": "object",
              "required": [
                "input_tokens",
                "output_tokens",
                "cache_read_tokens",
                "cache_write_tokens"
              ],
              "properties": {
                "input_tokens": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ]
                },
                "output_tokens": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ]
                },
                "cache_read_tokens": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ]
                },
                "cache_write_tokens": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "limits": {
      "type": "object",
      "required": [
        "timeout_ms",
        "max_output_tokens"
      ],
      "properties": {
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": [
        "correlation_id"
      ],
      "properties": {
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://107pilot.local/schemas/agent/v2/turn-request.schema.json",
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 256000
        },
        {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": {
            "not": {
              "pattern": "^(?:[aA][pP][iI]_[kK][eE][yY]|[aA][uU][tT][hH][oO][rR][iI][zZ][aA][tT][iI][oO][nN]|[bB][aA][sS][eE]_[uU][rR][lL]|[sS][yY][sS][tT][eE][mM]_[pP][rR][oO][mM][pP][tT]|[sS][cC][hH][eE][mM][aA]|[tT][oO][oO][lL][sS])$"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
