{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://107pilot.local/schemas/agent/v2/agent-task.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "owner",
    "session_id",
    "turn_id",
    "project_id",
    "workspace_id",
    "task_kind",
    "state",
    "version",
    "request_key",
    "cancel_requested",
    "resource_envelope",
    "linked_run_id",
    "result",
    "lease",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "pilot107.agent-task/v1"},
    "task_id": {"$ref": "#/$defs/id"},
    "owner": {"$ref": "#/$defs/id"},
    "session_id": {"$ref": "#/$defs/id"},
    "turn_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "workspace_id": {"$ref": "#/$defs/id"},
    "task_kind": {"enum": ["slurm_validation"]},
    "state": {"enum": ["pending", "running", "succeeded", "failed", "cancelled", "auth_required"]},
    "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "request_key": {"$ref": "#/$defs/id"},
    "completion_policy": {"$ref": "#/$defs/completionPolicy"},
    "gate_state": {"$ref": "#/$defs/gateState"},
    "schedule_receipt": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/scheduleReceipt"}
      ]
    },
    "gate_receipt": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/gateReceipt"}
      ]
    },
    "legacy_gate_unverified": {"type": "boolean"},
    "cancel_requested": {"type": "boolean"},
    "resource_envelope": {"$ref": "#/$defs/resourceEnvelope"},
    "linked_run_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "result": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["status", "evidence_refs", "error_code", "message"],
          "properties": {
            "status": {"enum": ["succeeded", "failed", "cancelled", "auth_required"]},
            "evidence_refs": {
              "type": "array",
              "maxItems": 4096,
              "items": {"type": "string", "minLength": 1, "maxLength": 4096}
            },
            "error_code": {
              "anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]
            },
            "message": {
              "anyOf": [
                {"type": "null"},
                {"type": "string", "minLength": 1, "maxLength": 4096}
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "lease": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["owner", "expires_at", "fencing_token"],
          "properties": {
            "owner": {"$ref": "#/$defs/id"},
            "expires_at": {"$ref": "#/$defs/timestamp"},
            "fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
          },
          "additionalProperties": false
        }
      ]
    },
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "completionPolicy": {
      "enum": ["evidence_required", "evidence_and_capsule_required"]
    },
    "gateState": {
      "enum": [
        "created", "admitted", "submitting", "pending", "running",
        "awaiting_run_terminal", "awaiting_evidence", "awaiting_integrity",
        "awaiting_capsule", "completed", "input_required", "cancelling",
        "cancelled", "failed", "blocked", "orphaned"
      ]
    },
    "scheduleReceipt": {
      "type": "object",
      "required": [
        "receipt_id", "task_id", "owner", "session_id", "originating_turn_id",
        "request_digest", "idempotency_key", "run_id", "submit_state",
        "slurm_job_id", "resource_envelope_id", "workspace_revision",
        "workspace_digest", "completion_policy", "created_at"
      ],
      "properties": {
        "receipt_id": {"$ref": "#/$defs/id"},
        "task_id": {"$ref": "#/$defs/id"},
        "owner": {"$ref": "#/$defs/id"},
        "session_id": {"$ref": "#/$defs/id"},
        "originating_turn_id": {"$ref": "#/$defs/id"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "idempotency_key": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "submit_state": {
          "enum": ["admitted", "submitting", "pending", "submitted", "submission_uncertain"]
        },
        "slurm_job_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "resource_envelope_id": {"$ref": "#/$defs/id"},
        "workspace_revision": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          ]
        },
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "completion_policy": {"$ref": "#/$defs/completionPolicy"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "legacy_boundary": {"type": "boolean"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"workspace_revision": {"type": "null"}}},
          "then": {
            "required": ["legacy_boundary"],
            "properties": {"legacy_boundary": {"const": true}}
          }
        },
        {
          "if": {"properties": {"workspace_revision": {"type": "integer"}}},
          "then": {
            "required": ["legacy_boundary"],
            "properties": {"legacy_boundary": {"const": false}}
          }
        }
      ]
    },
    "gateReceipt": {
      "type": "object",
      "required": [
        "task_id", "run_id", "run_terminal_state", "evidence_refs", "evidence_digest", "integrity_verified_at",
        "workspace_revision", "workspace_digest", "legacy_boundary", "capsule_ref",
        "capsule_state"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "run_id": {"$ref": "#/$defs/id"},
        "run_terminal_state": {"enum": ["completed", "failed", "cancelled", "orphaned"]},
        "evidence_state": {"const": "finalized"},
        "evidence_refs": {
          "type": "array",
          "maxItems": 4096,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "integrity_verified_at": {"$ref": "#/$defs/timestamp"},
        "integrity_state": {"const": "verified"},
        "platform_snapshot_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
        "source_revision": {"type": "string", "minLength": 1, "maxLength": 4096},
        "workspace_revision": {
          "anyOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          ]
        },
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "legacy_boundary": {"type": "boolean"},
        "capsule_ref": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 4096}]},
        "capsule_state": {"enum": ["READY", "not_required"]},
        "terminal_at": {"$ref": "#/$defs/timestamp"},
        "seal_digest": {"$ref": "#/$defs/digest"},
        "seal_marker_ref": {"type": "string", "minLength": 1, "maxLength": 4096}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"capsule_state": {"const": "READY"}}},
          "then": {"properties": {"capsule_ref": {"type": "string", "minLength": 1, "maxLength": 4096}}}
        },
        {
          "if": {"properties": {"capsule_state": {"const": "not_required"}}},
          "then": {"properties": {"capsule_ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"workspace_revision": {"type": "null"}}},
          "then": {
            "required": ["legacy_boundary"],
            "properties": {"legacy_boundary": {"const": true}}
          }
        },
        {
          "if": {"properties": {"workspace_revision": {"type": "integer"}}},
          "then": {
            "required": ["legacy_boundary"],
            "properties": {"legacy_boundary": {"const": false}}
          }
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "minLength": 20, "maxLength": 64},
    "resourceEnvelope": {
      "type": "object",
      "required": [
        "partition",
        "qos",
        "cpus",
        "memory_mib",
        "gpu_type",
        "gpus",
        "walltime_seconds",
        "max_tasks",
        "max_submissions",
        "workspace_snapshot_digest",
        "expires_at",
        "approved_by"
      ],
      "properties": {
        "partition": {"type": "string", "minLength": 1, "maxLength": 128},
        "qos": {"type": "string", "minLength": 1, "maxLength": 128},
        "cpus": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "memory_mib": {"type": "integer", "minimum": 1, "maximum": 1125899906842624},
        "gpu_type": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 128}
          ]
        },
        "gpus": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "walltime_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "max_tasks": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_submissions": {"type": "integer", "minimum": 1, "maximum": 1024},
        "workspace_snapshot_digest": {"$ref": "#/$defs/digest"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "approved_by": {"$ref": "#/$defs/id"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["completion_policy"]},
      "then": {
        "required": [
          "completion_policy", "gate_state", "schedule_receipt",
          "gate_receipt", "legacy_gate_unverified"
        ]
      }
    },
    {
      "if": {
        "required": ["completion_policy", "gate_receipt"],
        "properties": {
          "completion_policy": {"const": "evidence_and_capsule_required"},
          "gate_receipt": {"type": "object"}
        }
      },
      "then": {
        "properties": {
          "gate_receipt": {
            "properties": {
              "capsule_state": {"const": "READY"},
              "capsule_ref": {"type": "string", "minLength": 1, "maxLength": 4096}
            }
          }
        }
      }
    }
  ]
}
