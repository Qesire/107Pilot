{
  "type": "object",
  "required": [
    "schema_version",
    "turn_id",
    "lineage",
    "model_profile_id",
    "prompt_profile_id",
    "messages",
    "completed_tools",
    "usage",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pilot107.agent-checkpoint/v1"
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:-]+$"
      },
      "maxItems": 256
    },
    "model_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "prompt_profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content",
          "tool_call_id",
          "tool_name",
          "is_error"
        ],
        "properties": {
          "role": {
            "anyOf": [
              {
                "type": "string",
                "const": "user"
              },
              {
                "type": "string",
                "const": "assistant"
              },
              {
                "type": "string",
                "const": "tool_result"
              }
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 256000
          },
          "tool_call_id": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            ]
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:-]+$"
              }
            ]
          },
          "is_error": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "completed_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_call_id",
          "tool_name",
          "arguments",
          "result",
          "is_error"
        ],
        "properties": {
          "tool_call_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "tool_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "arguments": {
            "type": "object",
            "maxProperties": 4096,
            "propertyNames": {
              "not": {
                "pattern": "^(?:api_key|authorization|base_url|system_prompt|schema|tools)$"
              }
            },
            "additionalProperties": {
              "$ref": "#/$defs/jsonValue"
            }
          },
          "result": {
            "$ref": "#/$defs/jsonValue"
          },
          "is_error": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_tokens"
      ],
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "cache_read_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://107pilot.local/schemas/agent/v1/checkpoint.schema.json",
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "maxLength": 256000
        },
        {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 4096,
          "propertyNames": {
            "not": {
              "pattern": "^(?:api_key|authorization|base_url|system_prompt|schema|tools)$"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
