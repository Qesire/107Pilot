{
  "name": "pilot107-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build --config apps/web/vite.config.mts",
    "dev": "vite --config apps/web/vite.config.mts",
    "preview": "vite preview --config apps/web/vite.config.mts",
    "typecheck": "tsc --project apps/web/tsconfig.json --noEmit",
    "check:js": "npm run typecheck",
    "test": "vitest run --config apps/web/vite.config.mts",
    "test:ui": "npm run build && playwright test",
    "screenshots": "npm run build && playwright test tests/ui/visual.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@tanstack/react-query": "^5.66.8",
    "@uiw/react-codemirror": "^4.25.11",
    "ajv": "^8.20.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.2",
    "react-selecto": "^1.26.3",
    "tus-js-client": "^4.3.1",
    "yaml": "^2.9.0"
  }
}
