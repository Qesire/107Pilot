{
  "schema_version": "pilot107.contract/v2",
  "recipe_version_id": "recipe_gpu_shard_array_atomic@2.0.0",
  "project": {
    "name": "pipeline-gpu-shards",
    "workdir": "/public/home/alice/experiments/pipeline"
  },
  "entry": {
    "command": "python tools/build_shard.py"
  },
  "runtime": {
    "conda_env": "project-runtime",
    "environment": {
      "SLURM_ACCOUNT": "stu",
      "KIT_ROOT": "/public/home/alice/project-kit",
      "DATA_ROOT": "/public/home/alice/datasets/project",
      "EXPECTED_TASKS": "80"
    }
  },
  "resources": {
    "partition": "Students",
    "qos": "qos_stu_medium_2gpu",
    "nodes": 1,
    "ntasks": 1,
    "cpus_per_task": 12,
    "memory": "128G",
    "gpu_type": "A100",
    "gpus_per_node": 1,
    "time_limit": "12:00:00",
    "array": {
      "expression": "0-79",
      "max_concurrency": 2
    }
  },
  "workflow": {
    "dependencies": [
      "run_preflight_gate"
    ],
    "retry": {
      "max_attempts": 1,
      "backoff_seconds": 0
    }
  },
  "outputs": {
    "expected": [
      "shards/task_<id>.bin",
      "shards/task_<id>.json",
      "complete/task_<id>.COMPLETE"
    ],
    "success_conditions": [
      "slurm_exit_code_zero"
    ]
  }
}
