SLURM_SIM_IMAGE=pilot107/slurm-sim:25.11-real107
PILOT107_API_IMAGE=pilot107/api:local
PILOT107_WORKER_IMAGE=pilot107/worker:local
PILOT107_WEB_IMAGE=pilot107/web:local
PILOT107_REVERSE_PROXY_IMAGE=pilot107/web:local

MARIADB_ROOT_PASSWORD=pilot107-root
MARIADB_DATABASE=slurm_acct_db
MARIADB_USER=slurm
MARIADB_PASSWORD=pilot107-slurm

SLURM_JWT=dev-token
SLURMRESTD_PORT=127.0.0.1:16820
PILOT107_API_PORT=127.0.0.1:18080
PILOT107_WEB_PORT=127.0.0.1:13000
PILOT107_HTTP_PORT=8088
PILOT107_HTTPS_PORT=8443

PILOT107_REST_AUTH_STYLE=slurm_headers
PILOT107_SLURM_USER_NAME=alice
PILOT107_SLURM_API_VERSION=v0.0.41
PILOT107_REST_TOKEN_PROVIDER=1
PILOT107_WEB_DEMO_USER=alice
PILOT107_WEB_IDENTITY_MODE=fixed_user
PILOT107_WEB_FIXED_USER=alice
PILOT107_ALLOWED_ROOTS=/public/home/alice
PILOT107_COMMAND_GATEWAY_TOKEN=competition-dev-token
PILOT107_COMMAND_GATEWAY_PORT=127.0.0.1:18090
# Two-machine app-node mode: set to the Slurm host command-gateway endpoint.
PILOT107_REMOTE_COMMAND_GATEWAY_URL=http://<slurm-host-ip>:18090
PILOT107_GATEWAY_RATE_LIMIT_MAX=6000
PILOT107_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60

# Optional OpenAI-compatible campus/USTC LLM provider. Do not commit real keys.
# OpenCode provider: ustc-deepseek/deepseek-v4-flash-ascend.
PILOT107_LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
PILOT107_LLM_API_KEY=
PILOT107_LLM_MODEL=deepseek-v4-flash-ascend
PILOT107_LLM_TIMEOUT_SECONDS=60
PILOT107_LLM_MAX_TOKENS=1200
PILOT107_LLM_STRUCTURED_OUTPUT_MODE=prompt_json
PILOT107_LLM_MAX_ATTEMPTS=2
