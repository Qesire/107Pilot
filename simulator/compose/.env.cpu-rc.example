# Image tags: ":cpu-rc" is a FLOATING tag that is re-pushed on every build,
# so the exact image content changes over time. For production or competition
# deploys, PIN the tag to a revision tag ":cpu-rc-<revision>" produced by
# scripts/build-cpu-rc-images.sh so the deployed image is immutable and
# reproducible. The ":cpu-rc" defaults below are kept for local/dev parity
# and are asserted by tests; do NOT change them.
SLURM_SIM_IMAGE=pilot107/slurm-sim:cpu-rc
PILOT107_API_IMAGE=pilot107/api:cpu-rc
PILOT107_WORKER_IMAGE=pilot107/worker:cpu-rc
PILOT107_WEB_IMAGE=pilot107/web:cpu-rc
PILOT107_REVERSE_PROXY_IMAGE=pilot107/web:cpu-rc
PILOT107_AGENTD_IMAGE=pilot107/agentd:local

MARIADB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MARIADB_DATABASE=slurm_acct_db
MARIADB_USER=slurm
MARIADB_PASSWORD=REPLACE_WITH_RANDOM_SLURM_PASSWORD
SLURM_JWT=REPLACE_WITH_RANDOM_JWT

SLURMRESTD_PORT=127.0.0.1:16820
PILOT107_API_PORT=127.0.0.1:18080
PILOT107_WEB_PORT=127.0.0.1:13000
PILOT107_HTTP_PORT=8088
PILOT107_HTTPS_PORT=8443

PILOT107_WEB_IDENTITY_MODE=fixed_user
PILOT107_WEB_FIXED_USER=alice
PILOT107_ALLOWED_ROOTS=/public/home/alice
PILOT107_COMMAND_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_GATEWAY_TOKEN
PILOT107_GATEWAY_RATE_LIMIT_MAX=1200
PILOT107_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
PILOT107_PROXY_HMAC_SECRET_FILE=./secrets/proxy-hmac.local
PILOT107_SECRET_GID=10700
PILOT107_AGENTD_TOKEN=REPLACE_WITH_RANDOM_AGENTD_TOKEN
PILOT107_AGENTD_MODEL_PROFILE=campus-default
PILOT107_AGENTD_FAUX_SCENARIO=
PILOT107_AGENTD_TIMEOUT_SECONDS=630
PILOT107_AGENTD_MAX_OUTPUT_TOKENS=12000
PILOT107_WORKER_TASK_LEASE_SECONDS=660
PILOT107_AGENT_CAPABILITY_HMAC_SECRET_FILE=./secrets/agent-capability-hmac.local

# CPU release candidate is deterministic without a model. Configure these only
# when an approved OpenAI-compatible endpoint is available.
# To enable USTC qwen3.8-reasoner (OpenAI-compatible), set the API key from the
# opencode config (ustc-107 provider) into the gitignored .env.cpu-rc on the
# VM at deploy time. Do NOT commit the real key.
PILOT107_LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
PILOT107_LLM_API_KEY=
PILOT107_LLM_MODEL=qwen3.8-reasoner
# Reasoning models need longer timeout + more tokens than defaults (20s/700).
# Without these, agent suggest calls time out and return empty fallback.
PILOT107_LLM_TIMEOUT_SECONDS=600
PILOT107_LLM_MAX_TOKENS=12000
PILOT107_LLM_MAX_ATTEMPTS=3

# Source context for Agent diagnosis and remediation planning. The CPU release
# candidate is a self-contained simulation: job workspaces live under
# /public/home inside the compose stack, so the local transport is safe and is
# required for the Agent to emit create_repair_ticket actions and for
# RepairTickets to carry a source window (without it, remediation planning sees
# has_code_context=False and the repair-handoff flow is unavailable).
# ALLOWED_ROOTS must cover the user's workspace; git safe.directory is already
# allowed via GIT_CONFIG_* in compose.yml. When targeting a REAL platform over
# SSH instead, switch transport to ssh and configure the SSH_* settings below
# (open an MFA-authenticated ControlMaster via scripts/manage-code-context-ssh.sh;
# do not place a password, OTP, private key, or a broad home directory here).
PILOT107_CODE_CONTEXT_TRANSPORT=local
PILOT107_CODE_CONTEXT_ALLOWED_ROOTS=/public/home
PILOT107_CODE_CONTEXT_SSH_TARGET=
PILOT107_CODE_CONTEXT_SSH_CONTROL_PATH=/var/lib/pilot107/ssh/real107.sock
PILOT107_CODE_CONTEXT_SSH_PORT=22
PILOT107_CODE_CONTEXT_MAX_CHUNKS=3
PILOT107_CODE_CONTEXT_BEFORE_LINES=60
PILOT107_CODE_CONTEXT_AFTER_LINES=60
PILOT107_CODE_CONTEXT_MAX_FILE_BYTES=65536

# Optional real 107 backend. Keep these empty for the simulator presentation
# and use compose.real107-ssh.yml only for an explicitly authenticated session.
PILOT107_SSH_CONNECTION_ID=real107
PILOT107_SSH_TARGET_ID=real107
PILOT107_SSH_TARGET=
PILOT107_SSH_CONTROL_PATH=/var/lib/pilot107/ssh/real107.sock
PILOT107_SSH_KNOWN_HOSTS_FILE=/var/lib/pilot107/ssh/known_hosts
PILOT107_SSH_PORT=22
PILOT107_SSH_PORTAL_OWNER=
PILOT107_SSH_SLURM_USER=
PILOT107_SSH_OWNER_ROOTS=

# Web BFF public origin (used for CSRF Origin check). Set to the public URL
# users actually visit, including scheme + host + port. Without this the BFF
# falls back to http://{host}, which mismatches the browser's https:// Origin
# and every POST gets CSRF.ORIGIN_DENIED (403).
# PILOT107_WEB_PUBLIC_ORIGIN is derived from PILOT107_PUBLIC_URL by scripts/start-cpu-rc.sh.
# Do NOT hardcode a VM IP here. Set PILOT107_PUBLIC_URL before running start-cpu-rc.sh.
