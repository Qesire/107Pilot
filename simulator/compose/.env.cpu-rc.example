# Image tags: ":cpu-rc" is a FLOATING tag that is re-pushed on every build,
# so the exact image content changes over time. For production or competition
# deploys, PIN the tag to a revision tag ":cpu-rc-<revision>" produced by
# scripts/build-cpu-rc-images.sh so the deployed image is immutable and
# reproducible. The ":cpu-rc" defaults below are kept for local/dev parity
# and are asserted by tests; do NOT change them.
SLURM_SIM_IMAGE=pilot107/slurm-sim:cpu-rc
PILOT107_API_IMAGE=pilot107/api:cpu-rc
PILOT107_WORKER_IMAGE=pilot107/worker:cpu-rc
PILOT107_WEB_IMAGE=pilot107/web:cpu-rc
PILOT107_REVERSE_PROXY_IMAGE=pilot107/web:cpu-rc

MARIADB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_PASSWORD
MARIADB_DATABASE=slurm_acct_db
MARIADB_USER=slurm
MARIADB_PASSWORD=REPLACE_WITH_RANDOM_SLURM_PASSWORD
SLURM_JWT=REPLACE_WITH_RANDOM_JWT

SLURMRESTD_PORT=127.0.0.1:16820
PILOT107_API_PORT=127.0.0.1:18080
PILOT107_WEB_PORT=127.0.0.1:13000
PILOT107_HTTP_PORT=8088
PILOT107_HTTPS_PORT=8443

PILOT107_WEB_IDENTITY_MODE=fixed_user
PILOT107_WEB_FIXED_USER=alice
PILOT107_ALLOWED_ROOTS=/public/home/alice
PILOT107_COMMAND_GATEWAY_TOKEN=REPLACE_WITH_RANDOM_GATEWAY_TOKEN
PILOT107_GATEWAY_RATE_LIMIT_MAX=1200
PILOT107_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
PILOT107_PROXY_HMAC_SECRET_FILE=./secrets/proxy-hmac.local
PILOT107_SECRET_GID=10700

# CPU release candidate is deterministic without a model. Configure these only
# when an approved OpenAI-compatible endpoint is available.
# To enable USTC glm-5.2-107 (OpenAI-compatible), set the API key from the
# opencode config (ustc-107 provider) into the gitignored .env.cpu-rc on the
# VM at deploy time. Do NOT commit the real key.
PILOT107_LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
PILOT107_LLM_API_KEY=
PILOT107_LLM_MODEL=glm-5.2-107
PILOT107_LLM_STRUCTURED_OUTPUT_MODE=prompt_json
# Reasoning models (glm-5.2-107) need longer timeout + more tokens than defaults (20s/700).
# Without these, agent suggest calls time out and return empty fallback.
PILOT107_LLM_TIMEOUT_SECONDS=60
PILOT107_LLM_MAX_TOKENS=2000

# Web BFF public origin (used for CSRF Origin check). Set to the public URL
# users actually visit, including scheme + host + port. Without this the BFF
# falls back to http://{host}, which mismatches the browser's https:// Origin
# and every POST gets CSRF.ORIGIN_DENIED (403).
# PILOT107_WEB_PUBLIC_ORIGIN is derived from PILOT107_PUBLIC_URL by scripts/start-cpu-rc.sh.
# Do NOT hardcode a VM IP here. Set PILOT107_PUBLIC_URL before running start-cpu-rc.sh.
