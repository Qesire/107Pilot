SLURM_SIM_IMAGE=pilot107/slurm-sim:25.11-real107
PILOT107_API_IMAGE=pilot107/api:local
PILOT107_WORKER_IMAGE=pilot107/worker:local
PILOT107_WEB_IMAGE=pilot107/web:local

MARIADB_ROOT_PASSWORD=pilot107-root
MARIADB_DATABASE=slurm_acct_db
MARIADB_USER=slurm
MARIADB_PASSWORD=pilot107-slurm

SLURM_JWT=dev-token
SLURMRESTD_PORT=6820
PILOT107_API_PORT=8080
PILOT107_WEB_PORT=3000
PILOT107_WEB_IDENTITY_MODE=demo
PILOT107_WEB_FIXED_USER=
PILOT107_REST_AUTH_STYLE=slurm_headers
PILOT107_SLURM_USER_NAME=alice
# When switching the API/worker backend to rest-native, set these so the
# service mints per-user JWTs via `scontrol token` inside the simulator
# instead of using a static PILOT107_SLURM_TOKEN. The simulator's slurmrestd
# Slurm 25.11 simulator target matches the observed real107 REST API family.
PILOT107_SLURM_API_VERSION=v0.0.41
PILOT107_REST_TOKEN_PROVIDER=1

# Optional OpenAI-compatible campus/USTC LLM provider for
# POST /api/v1/runs/{run_id}/agent/explain with {"provider":"local"}.
# Keep API keys out of committed files; set these in a local .env override.
PILOT107_LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
PILOT107_LLM_API_KEY=
PILOT107_LLM_MODEL=deepseek-v4-flash-ascend
PILOT107_LLM_TIMEOUT_SECONDS=60
PILOT107_LLM_MAX_TOKENS=1200
PILOT107_LLM_STRUCTURED_OUTPUT_MODE=prompt_json
PILOT107_LLM_MAX_ATTEMPTS=2
